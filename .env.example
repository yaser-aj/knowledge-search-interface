# Free key: https://openrouter.ai/keys
# Without a key the app still ingests documents and answers with the
# deterministic planner + extractive writer (no LLM calls).
OPENROUTER_API_KEY=

# Primary model for the plan / write / verify nodes.
# Fallbacks are applied automatically on 429 or 5xx, in this order.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
